#include <windows.h>
#include "resource.h"
#pragma code_page(65001)
1 RT_MANIFEST "app.manifest"

IDD_MANAGER DIALOGEX 0, 0, 310, 176
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Nvidia Quick Switch — presets"
FONT 9, "Segoe UI"
BEGIN
  LTEXT "Presets select a primary display and change global NVIDIA settings.", -1, 10, 9, 290, 20
  LISTBOX IDC_PRESETS, 10, 32, 219, 106, LBS_NOTIFY | WS_VSCROLL | WS_TABSTOP | WS_BORDER
  PUSHBUTTON "New…", IDC_NEW, 236, 32, 64, 16
  PUSHBUTTON "Edit…", IDC_EDIT, 236, 54, 64, 16
  PUSHBUTTON "Delete", IDC_DELETE, 236, 76, 64, 16
  LTEXT "Changes are saved immediately. Apply presets from the tray menu.", -1, 10, 145, 218, 23
  DEFPUSHBUTTON "Close", IDCANCEL, 236, 148, 64, 18
END

IDD_EDITOR DIALOGEX 0, 0, 350, 291
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Display preset"
FONT 9, "Segoe UI"
BEGIN
  LTEXT "Name", -1, 12, 12, 76, 12
  EDITTEXT IDC_NAME, 98, 10, 238, 14, ES_AUTOHSCROLL
  LTEXT "Target monitor", -1, 12, 36, 76, 12
  COMBOBOX IDC_MONITOR, 98, 33, 238, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
  CONTROL "Make this the primary monitor", IDC_PRIMARY, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 98, 57, 220, 12
  LTEXT "Resolution", -1, 12, 82, 76, 12
  EDITTEXT IDC_WIDTH, 98, 79, 69, 14, ES_AUTOHSCROLL | ES_NUMBER
  LTEXT "×", -1, 174, 82, 9, 12
  EDITTEXT IDC_HEIGHT, 188, 79, 69, 14, ES_AUTOHSCROLL | ES_NUMBER
  LTEXT "Refresh rate (Hz)", -1, 12, 106, 83, 12
  EDITTEXT IDC_REFRESH, 98, 103, 69, 14, ES_AUTOHSCROLL
  LTEXT "Blank resolution/rate = leave unchanged", -1, 176, 106, 163, 24
  LTEXT "GPU scaling", -1, 12, 133, 76, 12
  COMBOBOX IDC_SCALING, 98, 130, 238, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
  LTEXT "Global G-SYNC", -1, 12, 157, 82, 12
  COMBOBOX IDC_GSYNC, 98, 154, 238, 100, CBS_DROPDOWNLIST | WS_TABSTOP
  LTEXT "Global V-SYNC", -1, 12, 181, 82, 12
  COMBOBOX IDC_VSYNC, 98, 178, 238, 100, CBS_DROPDOWNLIST | WS_TABSTOP
  LTEXT "Global max FPS", -1, 12, 205, 82, 12
  EDITTEXT IDC_FPS, 98, 202, 69, 14, ES_AUTOHSCROLL | ES_NUMBER
  LTEXT "Blank = unchanged; 0 = off; 1–1023 = cap", -1, 176, 205, 163, 20
  PUSHBUTTON "Capture current settings", IDC_CAPTURE, 12, 233, 116, 18
  LTEXT "Other monitors stay enabled. Apply before starting a game.\nDSR/DLDSR factors are not changed.", -1, 140, 231, 198, 27
  DEFPUSHBUTTON "Save", IDOK, 208, 266, 61, 18
  PUSHBUTTON "Cancel", IDCANCEL, 275, 266, 61, 18
END

IDD_CONFIRM DIALOGEX 0, 0, 305, 102
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Keep this display preset?"
FONT 10, "Segoe UI"
BEGIN
  LTEXT "", IDC_STATUS, 12, 12, 280, 43
  PUSHBUTTON "Keep", IDOK, 158, 72, 64, 19
  DEFPUSHBUTTON "Revert", IDCANCEL, 230, 72, 64, 19
END

IDD_DIAGNOSTICS DIALOGEX 0, 0, 400, 250
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Nvidia Quick Switch — read-only diagnostics"
FONT 9, "Segoe UI"
BEGIN
  EDITTEXT IDC_TEXT, 10, 10, 380, 207, ES_MULTILINE | ES_AUTOVSCROLL | ES_AUTOHSCROLL | ES_READONLY | WS_VSCROLL | WS_HSCROLL
  DEFPUSHBUTTON "Close", IDCANCEL, 326, 226, 64, 18
END
